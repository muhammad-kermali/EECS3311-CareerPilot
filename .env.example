# .env.example - contains no real credentials.
# Copy this file to .env (which is git-ignored) and put your own key in .env only.
#
# Default: Google Gemini free tier through its OpenAI-compatible API.
# Get a key at https://aistudio.google.com (no payment needed).
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# To use OpenAI instead, set:
# LLM_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=60
WORKSPACE_DIR=workspace
